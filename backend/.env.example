# Copy this file to ".env" in the same folder and fill in the values.
# Restart the backend after changing it. Never share or commit the real .env.

# Which translation service to use for messages in other languages:
# sarvam, azure or none. Leave it empty to use whichever key is filled in below.
TRANSLATOR_PROVIDER=sarvam

# Sarvam (https://docs.sarvam.ai -> sign in -> API keys)
SARVAM_API_KEY=
# Only change these if Sarvam tells you to.
# SARVAM_ENDPOINT=https://api.sarvam.ai
# SARVAM_MODEL=sarvam-translate:v1

# Spoken prompts use the same Sarvam key. Optional settings:
# SPEECH_PROVIDER=none          (turns spoken prompts off)
# SARVAM_TTS_SPEAKER=shubh      (Telugu picks from Sarvam: shubh, ratan, neha, priya)
# SARVAM_TTS_PACE=0.9           (slower is easier to follow; 0.5 to 2.0)

# Azure Translator (an alternative; Azure portal -> your Translator resource -> Keys and Endpoint)
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Before deploying anywhere public, set a long random secret:
# JWT_SECRET=
